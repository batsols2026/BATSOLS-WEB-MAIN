# Supabase (BATsols project) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ikipcdezxywajggjjasc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wqPwJgTkxVj7VqHlvMSegw_b4Sv7Xjn

# Server-only. Get this from Supabase Dashboard -> this project -> Project
# Settings -> API -> service_role secret. Required for checkout, downloads,
# and any admin write. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Site -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BATsols
CONTACT_INBOX_EMAIL=hello@batsols.com

# Stripe (optional) -----------------------------------------------------------
# Leave blank and only Bank Transfer will be offered at checkout. Add real
# keys once you're ready to accept card payments - Card appears automatically.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bank transfer details, the WhatsApp number, the support email, and the
# download-link lifetime are NOT set here anymore - they're managed by an
# admin from the browser at /admin/settings, stored in the `bank_accounts`
# and `site_settings` tables. Sign in as an admin and fill them in there.

# Email alerts (optional) -----------------------------------------------------
# Leave blank and admins just check /admin/orders manually. Add these to get
# an instant email the moment a customer uploads bank-transfer proof, so
# confirmation no longer waits on someone remembering to look.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_ALERT_EMAIL=
